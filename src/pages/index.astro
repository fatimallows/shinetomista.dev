---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { shine } from "../data/shine";

const { hero } = shine;
---

<Layout>
  <Header />
  <main class="container hero">
    <div class="hero-grid">
      <div class="hero-copy">
        <h1 class="wordmark">{hero.wordmark}</h1>
        <p class="tagline">{hero.tagline}</p>
        <div class="ctas">
          {
            hero.ctas.map((cta) => (
              <a href={cta.href} class={`btn btn-${cta.variant}`}>
                {cta.label}
              </a>
            ))
          }
        </div>
      </div>

      <div class="hero-visual">
        <span class="brace brace-open" aria-hidden="true">{"{"}</span>
        <div class="hero-photo">
          <img src={hero.photo} alt="Shine Tomista" />
        </div>
        <div class="object-code" aria-hidden="true">
          <p class="line">
            <span class="key">role:</span>{" "}
            <span class="str" id="role-value">"{hero.object.roles[0]}"</span
            ><span class="caret"></span>,
          </p>
          <p class="line">
            <span class="key">school:</span>{" "}
            <span class="str">"{hero.object.school}"</span>,
          </p>
          <p class="line"><span class="key">into:</span> [</p>
          {
            hero.object.into.map((item, i) => (
              <p class="line indent">
                <span class="str">"{item}"</span>
                {i < hero.object.into.length - 1 ? "," : ""}
              </p>
            ))
          }
          <p class="line">],</p>
          <p class="line">
            <span class="key">status:</span>{" "}
            <span class="str">"{hero.object.status}"</span>
          </p>
        </div>
        <span class="brace brace-close" aria-hidden="true">{"}"}</span>
      </div>
    </div>
  </main>

  <script define:vars={{ roles: hero.object.roles }}>
    const el = document.getElementById("role-value");
    if (el) {
      let wordIndex = 0;
      const loop = () => {
        const word = roles[wordIndex % roles.length];
        let i = 0;
        const typeInterval = setInterval(() => {
          el.textContent = `"${word.slice(0, i + 1)}"`;
          i++;
          if (i > word.length) {
            clearInterval(typeInterval);
            setTimeout(() => {
              let j = word.length;
              const delInterval = setInterval(() => {
                j--;
                el.textContent = `"${word.slice(0, Math.max(j, 0))}"`;
                if (j <= 0) {
                  clearInterval(delInterval);
                  wordIndex++;
                  setTimeout(loop, 250);
                }
              }, 45);
            }, 1600);
          }
        }, 85);
      };
      loop();
    }
  </script>
</Layout>

<style>
  .hero {
    padding-top: 80px;
    padding-bottom: 64px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 56px;
    align-items: start;
  }

  @media (min-width: 800px) {
    .hero-grid {
      grid-template-columns: minmax(320px, 460px) 1fr;
      gap: 48px;
      align-items: center;
    }
  }

  .wordmark {
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
    font-size: clamp(64px, 9vw, 190px);
  }

  .tagline {
    font-weight: 500;
    color: var(--body);
    font-size: clamp(17px, 1.3vw, 23px);
    line-height: 1.45;
    max-width: 440px;
    margin-top: 28px;
  }

  .ctas {
    display: flex;
    gap: 12px;
    margin-top: 40px;
    flex-wrap: wrap;
  }

  .btn {
    font-weight: 700;
    font-size: 15px;
    padding: 15px 22px;
    border-radius: 999px;
    white-space: nowrap;
  }

  .btn-solid {
    background: var(--ink);
    color: #fff;
  }

  .btn-outline {
    border: 1.5px solid var(--ink);
    color: var(--ink);
  }

  /*
   * Proportional 1:1 recreation of the Figma hero visual (830 x 605 design
   * space, measured from the brace-open's left edge to the brace-close's
   * right edge). Every child is positioned as a percentage of this box and
   * sized with container-query units, so the whole composition — braces,
   * photo, object text — scales together instead of reflowing.
   */
  .hero-visual {
    position: relative;
    width: 100%;
    max-width: min(950px, calc((100vh - 224px) * 1.3719));
    aspect-ratio: 830 / 605;
    container-type: inline-size;
  }

  .brace {
    position: absolute;
    top: 0.83%;
    height: 76.03%;
    width: 20.48%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 400;
    color: var(--pink);
    font-size: clamp(40px, 55.4cqw, 530px);
    line-height: 1;
    user-select: none;
  }

  .brace-open {
    left: 0;
  }

  .brace-close {
    left: 79.52%;
  }

  .hero-photo {
    position: absolute;
    left: 18.67%;
    top: 0;
    width: 32.41%;
    height: 100%;
  }

  .hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .object-code {
    position: absolute;
    left: 46.51%;
    top: 24.63%;
    width: 30.12%;
    font-family: var(--font-mono);
    font-size: clamp(9px, 1.93cqw, 19px);
    color: var(--ink);
    line-height: 1.95;
  }

  .object-code .line {
    white-space: pre;
  }

  .object-code .indent {
    padding-left: 1.4em;
  }

  .key {
    color: var(--muted);
  }

  .str {
    color: var(--accent);
  }

  .caret {
    display: inline-block;
    width: 0.5em;
    height: 1em;
    background: var(--ink);
    vertical-align: -0.15em;
    margin-left: 2px;
    animation: blink 1s steps(2, start) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
