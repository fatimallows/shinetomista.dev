---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { shine } from "../data/shine";

const { about } = shine;
---

<Layout title={`about — ${shine.meta.title}`}>
  <Header />
  <main class="container page">
    <Breadcrumb current="about" />
    <h1 class="page-title">about<span class="bracket">{"{"}</span></h1>

    <div class="about-grid">
      <div class="portrait">
        <img src={about.portrait} alt="Shine Tomista" />
      </div>
      <div class="fields">
        <div class="field">
          <p class="key">bio:</p>
          <p class="bio">{about.bio}</p>
        </div>
        <div class="field">
          <p class="key">likes:</p>
          <div class="chips">
            {about.likes.map((like) => <span class="chip">{like}</span>)}
          </div>
        </div>
        <div class="field">
          <p class="key">currently:</p>
          <div class="currently">
            {about.currently.map((line) => <p>{line}</p>)}
          </div>
        </div>
      </div>
    </div>

    <p class="gallery-key">
      <span class="muted">gallery: </span><span class="bracket-inline">[</span
      >
    </p>
    <div class="gallery">
      {
        about.gallery.map((item) => (
          <div class="slot" style={{ aspectRatio: item.aspect }}>
            {item.src && <img src={item.src} alt="" loading="lazy" />}
          </div>
        ))
      }
    </div>
    <p class="gallery-end">],</p>

    <p class="bracket-close">{"}"}</p>
  </main>
</Layout>

<style>
  .page {
    padding-top: 64px;
    padding-bottom: 96px;
  }

  .page-title {
    display: flex;
    align-items: baseline;
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1.05;
    font-size: clamp(48px, 9vw, 104px);
    margin: 24px 0 0;
  }

  .bracket {
    color: var(--pink);
    margin-left: 6px;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    margin-top: 56px;
  }

  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: 480px 1fr;
      gap: 64px;
    }
  }

  .portrait img {
    width: 100%;
    border-radius: 12px;
    object-fit: cover;
    aspect-ratio: 480 / 600;
  }

  .fields {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .field .key {
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--muted);
    margin-bottom: 10px;
  }

  .bio {
    font-weight: 500;
    font-size: clamp(18px, 2.2vw, 24px);
    line-height: 1.42;
    color: var(--ink);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .chip {
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    padding: 10px 16px;
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--accent);
  }

  .currently p {
    font-weight: 500;
    font-size: 20px;
    color: var(--body);
    margin-bottom: 4px;
  }

  .gallery-key {
    font-family: var(--font-mono);
    font-size: 22px;
    color: var(--muted);
    margin-top: 72px;
  }

  .bracket-inline {
    color: var(--ink);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 24px;
  }

  @media (max-width: 800px) {
    .gallery {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .gallery {
      grid-template-columns: 1fr;
    }
  }

  .slot {
    background: var(--placeholder);
    border-radius: 12px;
    width: 100%;
    overflow: hidden;
  }

  .slot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery-end {
    font-family: var(--font-mono);
    font-size: 22px;
    color: var(--ink);
    margin-top: 24px;
  }

  .bracket-close {
    color: var(--pink);
    font-weight: 600;
    font-size: clamp(48px, 9vw, 104px);
    margin-top: 48px;
  }
</style>
